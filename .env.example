# Copy to backend/.env (or set these in your host's dashboard). Never commit the real .env.

# --- AI (required for chat) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- App ---
# SQLite for local dev; Postgres in production, e.g.
# DATABASE_URL=postgresql+psycopg://trippilot:trippilot@db:5432/trippilot
DATABASE_URL=sqlite:///./trippilot.db
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_CURRENCY=aud
# Comma-separated origins, only if the web app is hosted on a different domain
CORS_ORIGINS=
# Long random string; protects /api/admin/stats
ADMIN_TOKEN=

# --- Flights: Travelpayouts (https://www.travelpayouts.com) ---
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- Hotels: Booking.com Affiliate Partner id ("aid") ---
BOOKING_AID=

# --- Extras: paste the tracked link from each affiliate program ---
CAR_RENTAL_AFFILIATE_URL=
TRANSFER_AFFILIATE_URL=
ESIM_AFFILIATE_URL=
INSURANCE_AFFILIATE_URL=
TOURS_AFFILIATE_URL=

# --- Price alerts: triggered alerts are POSTed here (Zapier/Make/n8n -> email/SMS) ---
ALERT_WEBHOOK_URL=

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
